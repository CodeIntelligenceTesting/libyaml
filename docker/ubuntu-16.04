# vim: ft=dockerfile
FROM ubuntu:16.04
MAINTAINER Ian Cordasco <graffatcolmingov@gmail.com>

RUN apt-get update && \
    apt-get install -y \
        autoconf \
        build-essential \
        git \
        libtool && \
    rm -rf /var/lib/apt/lists/* && \
    mkdir /libci

COPY . /libci/
WORKDIR /libci

ENV LD_LIBRARY_PATH=/libci/src/.libs

RUN ./bootstrap && \
    ./configure && \
    make && \
    make install

CMD ["bash"]
