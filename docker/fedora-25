# vim: ft=dockerfile
FROM fedora:25
MAINTAINER Ian Cordasco <graffatcolmingov@gmail.com>

# NOTE(sigmavirus24): We need "perl-core" here for the "prove" binary
# required by the test-all Makefile target
RUN dnf install -y \
        automake \
        gcc \
        git \
        make \
        libtool \
        perl-core && \
    mkdir /libci

COPY . /libci/
WORKDIR /libci

ENV LD_LIBRARY_PATH=/libci/src/.libs

RUN ./bootstrap && \
    ./configure && \
    make && \
    make install

CMD ["bash"]
